[Unit]
Description=LLM Gateway — LiteLLM proxy (127.0.0.1:8900)
After=llm-model-manager.service
PartOf=llm-gateway.target

[Service]
# Prisma's engines live in the env, not in a per-user cache.
Environment=PRISMA_BINARY_CACHE_DIR=/home/derek/miniforge3/envs/llm-gateway-vllm/share/prisma-python
MemoryHigh=3G
MemoryMax=4G
MemorySwapMax=1G
User=derek
Group=derek
Environment=HOME=/home/derek
Environment=LANG=en_US.UTF-8
Type=simple
WorkingDirectory=/home/derek/Projects/llm-gateway
EnvironmentFile=-/home/derek/Projects/llm-gateway/gateway.env
ExecStart=/home/derek/Projects/llm-gateway/run_litellm.sh
Restart=on-failure
RestartSec=15
TimeoutStartSec=120
TimeoutStopSec=30
StandardOutput=append:/home/derek/Projects/llm-gateway/logs/litellm.log
StandardError=append:/home/derek/Projects/llm-gateway/logs/litellm.log

[Install]
WantedBy=llm-gateway.target
