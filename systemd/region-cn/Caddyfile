# TLS entrance for CN services that call the A100 directly (docs/region-cn.md),
# without Cloudflare: the site's NAT forwards <public ip>:CN_TLS_PORT to this
# host.  LiteLLM listens on loopback only (LITELLM_HOST=127.0.0.1), so this
# proxy is the one network-facing gateway port, and it serves only
# CN_ALLOW_CIDRS.  The certificate is issued on GPU4 and pushed here by
# scripts/region_cn_tls.sh, so the Cloudflare API token never lands on this
# shared host.  Variables come from gateway.env.
{
	admin off
	auto_https off
	storage file_system /data/derek/llm-gateway/run/caddy
}

{$CN_TLS_HOST}:{$CN_TLS_PORT} {
	tls /data/derek/llm-gateway/tls/fullchain.pem /data/derek/llm-gateway/tls/privkey.pem

	@denied not remote_ip {$CN_ALLOW_CIDRS}
	respond @denied 403

	# flush_interval -1: stream SSE chunks as they arrive.
	reverse_proxy 127.0.0.1:8900 {
		flush_interval -1
	}

	# Caddy redacts Authorization in access logs unless log_credentials is on.
	log {
		output file /data/derek/llm-gateway/logs/tls-proxy-access.log {
			roll_size 50MiB
			roll_keep 5
		}
	}
}
