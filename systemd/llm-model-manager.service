[Unit]
Description=LLM Gateway — model_manager (spawns/unloads vLLM on demand, :8002)
# No After=default.target: llm-gateway.target is WantedBy=default.target, so
# that line closed an ordering cycle which systemd broke by silently deleting
# this service's start job — the stack came up without model_manager.
PartOf=llm-gateway.target

[Service]
Type=simple
WorkingDirectory=/home/derek/Projects/llm-gateway
EnvironmentFile=-/home/derek/Projects/llm-gateway/gateway.env
ExecStart=/home/derek/Projects/llm-gateway/run_model_manager.sh
# process (not control-group): on stop/restart, signal ONLY model_manager, not
# its vLLM children.  model_manager's SIGTERM handler leaves the vLLM backends
# running and re-adopts them on next start (adopt_existing_backends), so a
# restart doesn't force a ~90s cold start.  Trade-off: `systemctl stop` leaves
# vLLM running until the next start adopts it (or you kill it manually).
KillMode=process
KillSignal=SIGTERM
TimeoutStopSec=120
Restart=on-failure
RestartSec=10
TimeoutStartSec=30
StandardOutput=append:/home/derek/Projects/llm-gateway/logs/model_manager.log
StandardError=append:/home/derek/Projects/llm-gateway/logs/model_manager.log

[Install]
WantedBy=llm-gateway.target
